PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_USER=iqs_user
DB_PASSWORD=iqs_password
DB_NAME=iqs_db
SEC_USER_AGENT=IQS Dashboard contact@example.com
INGEST_ON_BOOT=true
INGEST_CRON=0 */6 * * *

# Anthropic Claude API — powers the content engine, the /chat endpoint, and
# the News & Sentiment scoring pillar (headlines scored by Claude, cached 12h).
ANTHROPIC_API_KEY=

# Auth — HMAC signing secret for sign-in/sign-up tokens. Generate a fresh one
# with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# AI thumbnail generation — per-article cover images. Defaults to the free
# Pollinations endpoint; set both to use a paid provider.
# TODO: add your AI-image API endpoint/key to upgrade thumbnail quality.
AI_IMAGE_ENDPOINT=
AI_IMAGE_API_KEY=
