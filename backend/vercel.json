{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "dist/**"
    }
  },
  "crons": [
    { "path": "/api/ingest/cron", "schedule": "0 6 * * *" },
    { "path": "/api/market-stats/pe-cron", "schedule": "0 7 * * *" },
    { "path": "/api/market-stats/snapshot-cron", "schedule": "30 7 * * *" }
  ]
}
