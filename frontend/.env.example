# ── Backend ────────────────────────────────────────────────────────────────
# Where app/api/backend/[...path]/route.ts and lib/ssr/prefetch.ts send API
# traffic. Read per request (not baked at build).
BACKEND_URL=http://localhost:4000
BACKEND_TIMEOUT_MS=9000

# Canonical site origin for metadata / sitemaps.
NEXT_PUBLIC_SITE_URL=https://insiderbuying.com

# ── Bot gate (Cloudflare Turnstile) — see docs/bot-gate.md ────────────────
# The gate is FAIL-OPEN: unless BOT_GATE_ENABLED is exactly "1" AND all three
# keys below are set, middleware.ts passes every request untouched.
BOT_GATE_ENABLED=0
# "all" (default) challenges every visitor without a cookie once;
# "datacenter" only challenges when the UA looks automated or nginx sent
# `x-bot-suspect: 1`.
BOT_GATE_MODE=all
# Random 32+ byte secret used to HMAC-sign the `ib_verified` cookie.
# Rotating it logs every visitor out of the gate (one more challenge each).
#   openssl rand -hex 32
BOT_GATE_SECRET=
# Turnstile widget keys from the Cloudflare dashboard (Turnstile → Add site,
# "Managed" mode, hostname insiderbuying.com). The site key is public and is
# inlined into the client bundle at BUILD time; the secret stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
